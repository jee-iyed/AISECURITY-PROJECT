GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.8-flash
JWT_SECRET=
DATABASE_URL=sqlite:///./data/ai_security_gateway.db
